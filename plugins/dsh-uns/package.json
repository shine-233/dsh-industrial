  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "uns",
    "supos",
    "umh",
    "iiot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shine-233/dsh-industrial.git"
  },
  "engines": {
    "node": ">=22.19"
  },
